# Устанавливаем LF по умолчанию для всех текстовых файлов
* text=auto eol=lf

# Исходники и конфиги — строго LF
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Бинарные файлы — без обработки
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.apk binary
*.aab binary
*.jar binary
*.ttf binary
*.otf binary